# Copy to .env locally. Never commit real credentials.
# Prefer a DB account that is SELECT-only at the server.

# Driver: mssql | oracle (oracle is a stub — use mssql)
DB_DRIVER=mssql

# --- Microsoft SQL Server (placeholders) ---
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=YOUR_DATABASE
MSSQL_USER=YOUR_READONLY_USER
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# --- Oracle (placeholders; stub only when DB_DRIVER=oracle) ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=YOUR_SERVICE
ORACLE_USER=YOUR_READONLY_USER
ORACLE_PASSWORD=

# Optional shared guards (policy also enforces SELECT-only + allowlist)
SQL_TIMEOUT_MS=15000
SQL_MAX_ROWS=5000
