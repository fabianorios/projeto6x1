{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "../src/engine/**/*.ts",
    "../src/types/**/*.ts",
    "../src/apdata/mapExtractorRows.ts",
    "../src/apdata/classifyBenefit.ts"
  ],
  "exclude": ["src/**/*.test.ts", "../src/**/*.test.ts"]
}
