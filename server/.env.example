# Copy to server/.env locally. Never commit real credentials.
# Generate: openssl rand -hex 32

# Required in production (32-byte hex or base64)
ENCRYPTION_KEY=

# Listen (VPS: bind 127.0.0.1; reverse-proxy /api → this port)
HOST=127.0.0.1
PORT=8787

# Where encrypted environment records are stored (gitignored)
DATA_DIR=./data

# CORS — set to the Turnocheck origin in production
CORS_ORIGIN=*

# Shared SQL guards (same semantics as mcp/)
SQL_TIMEOUT_MS=15000
SQL_MAX_ROWS=5000

# NODE_ENV=production  # rejects missing ENCRYPTION_KEY
