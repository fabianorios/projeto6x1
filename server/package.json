{
  "name": "@projeto-6x1/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turnocheck API — multi-client Apdata environments (encrypted at rest, SELECT-only)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts src/*.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@projeto-6x1/mcp": "file:../mcp",
    "hono": "^4.9.0",
    "mssql": "^11.0.2",
    "oracledb": "^6.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
